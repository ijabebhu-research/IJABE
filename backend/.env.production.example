NODE_ENV=production
PORT=4000
FRONTEND_URL=https://your-site.vercel.app
# Optional: use this for a custom site domain and Vercel preview URL, separated by commas.
FRONTEND_URLS=https://www.example.org
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-unique-random-value-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-value-at-least-32-characters-long
ACCESS_TOKEN_TTL=8h
REFRESH_TOKEN_TTL=90d
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=ijabe-production
R2_PUBLIC_BASE_URL=https://files.example.org
